{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/YusufBeratZengin/prompt-lint/main/schema.json",
  "title": "prompt-lint configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTokens": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2000
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[pP][lL](00[1-9]|01[0-2])$": {
          "$ref": "#/$defs/severity"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[pP][lL](00[1-9]|01[0-2])$": {
          "type": "object",
          "description": "Options passed to the selected rule."
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Glob patterns appended to the default ignores."
    }
  },
  "$defs": {
    "severity": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([oO][fF][fF]|[iI][nN][fF][oO]|[wW][aA][rR][nN][iI][nN][gG]|[eE][rR][rR][oO][rR])$"
        },
        {
          "enum": [
            0,
            1,
            2,
            true,
            false
          ]
        }
      ],
      "description": "off, info, warning, error; 0/false = off, 1 = warning, 2/true = error."
    }
  }
}
